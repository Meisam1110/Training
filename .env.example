# Copy to .env and fill EVERY value. Nothing here is a working secret.
# Generate: openssl rand -base64 32   (data key)  |  openssl rand -base64 48   (secret key)

TMS_ENV=production
POSTGRES_PASSWORD=
# AES-256 key for personal data + connector secrets. LOSING IT MAKES THAT DATA UNREADABLE: back it up separately.
TMS_DATA_KEY=
# Pepper for session tokens (>= 32 random characters).
TMS_SECRET_KEY=
# First admin, used only while the users table is empty. Remove both lines after first login.
TMS_BOOTSTRAP_ADMIN_USER=admin
TMS_BOOTSTRAP_ADMIN_PASSWORD=

# Behind TLS (nginx): keep true. Plain HTTP LAN only: false (not recommended).
TMS_COOKIE_SECURE=true
TMS_HSTS=true
# Comma separated origins allowed cross-site. Empty = CORS closed (correct for the bundled SPA).
TMS_CORS_ORIGINS=
# Proxies whose X-Forwarded-For is trusted (comma list of IPs/CIDRs). The DEFAULT (loopback + 172.16.0.0/12, the docker bridge
# range) fits "nginx on the host -> published 127.0.0.1:8000". Add your proxy if it is elsewhere (e.g. 10.0.0.0/8).
# Untrusted peers can never set the client IP. Leave the default unless `docker network inspect` shows another subnet.
# TMS_TRUSTED_PROXIES=127.0.0.0/8,::1/128,172.16.0.0/12
# Only answer for these Host headers (comma list); recommended in production.
# TMS_TRUSTED_HOSTS=tms.example.internal

TMS_PORT=8000
TMS_BIND=127.0.0.1
TMS_LOG_LEVEL=INFO
TMS_AUTOMATION_ENABLED=true
TMS_AUTOMATION_INTERVAL_S=86400
TMS_MAX_UPLOAD_BYTES=26214400
TMS_TICKET_URL_BASE=https://icare.example.test/browse/
